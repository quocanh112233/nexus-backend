POSTGRES_ADMIN_PASSWORD=change-me
IDENTITY_DB_PASSWORD=change-me
COMMUNITY_DB_PASSWORD=change-me
MESSAGING_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=change-me
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=change-me
CLOUDINARY_UPLOAD_PRESET_AVATAR=nexus_avatar
CLOUDINARY_UPLOAD_PRESET_ATTACHMENT=nexus_attachment
CLOUDINARY_FOLDER_ROOT=nexus-dev
JWT_KEY_ID=nexus-1
# Phải khớp chính xác Origin của trình duyệt (so sánh chuỗi khi /auth/refresh kiểm Origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Cổng Postgres/Redis trên host nếu 5432/6379 bị chiếm (tùy chọn)
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# false chỉ cho local chạy HTTP; đặt true khi chạy sau HTTPS
COOKIE_SECURE=false
# OTEL_ENDPOINT=http://otel-lgtm:4318  (chỉ khi bật --profile observability)
